# =============================================================
# Gamanalk — Frontend Environment Variables
# =============================================================
# Copy this file and fill in real values before running locally.
# Add each variable to Vercel: Project Settings > Environment Variables
#
# Variables prefixed NEXT_PUBLIC_ are bundled into the browser.
# Never put secrets (private keys, DB URLs) in NEXT_PUBLIC_ vars.
# =============================================================

# ---------------------------------------------------------------
# Backend API (NestJS on Render)
# Set this to your Render service URL, including /api path suffix.
# Example: https://sri-way-tours-api.onrender.com/api
# ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api

# ---------------------------------------------------------------
# AWS Cognito (if used for authentication)
# ---------------------------------------------------------------
NEXT_PUBLIC_COGNITO_USER_POOL_ID=your_user_pool_id_here
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=your_user_pool_client_id_here

# ---------------------------------------------------------------
# Mapbox (if used for map features)
# ---------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
