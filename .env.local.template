# ============================================================
# sberry V2 — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# Variables WITHOUT that prefix are server-only.
# ============================================================

# --- REST API ---
# V1 equivalent: VITE_API_URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- AWS Cognito ---
# V1 equivalent: VITE_COGNITO_USER_POOL_ID
NEXT_PUBLIC_COGNITO_USER_POOL_ID=your_user_pool_id_here

# V1 equivalent: VITE_COGNITO_USER_POOL_CLIENT_ID
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=your_user_pool_client_id_here

# --- Mapbox ---
# V1 equivalent: VITE_MAPBOX_ACCESS_TOKEN
# Note: was not present in V1 .env but is referenced in src/config/mapbox.ts
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
